# Entorno
NODE_ENV=development
PORT=3000
TRUST_PROXY=false

# Seguridad
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=10

# Base de datos (usa :memory: para pruebas)
DATABASE_FILE=./data/foodexpress.db

# CORS: orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Pasarela de pagos: mock | stripe
# Con "mock" el pago se aprueba de inmediato (ideal para la demo).
# Con "stripe" se crea un PaymentIntent real usando STRIPE_SECRET_KEY.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=mxn

# OpenWeatherMap (opcional). Sin clave se usa un clima simulado.
OPENWEATHER_API_KEY=

# Entrega
DELIVERY_BASE_ETA_MINUTES=25
DELIVERY_FEE_CENTS=3500
DELIVERY_FREE_FROM_CENTS=30000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=12

# Administrador semilla (cambiar en producción)
ADMIN_NAME=Administrador FoodExpress
ADMIN_EMAIL=admin@foodexpress.com
ADMIN_PASSWORD=Admin123!
